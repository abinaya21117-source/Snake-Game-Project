
<!DOCTYPE html>
<html>
<head>
    <title>Advanced Snake Game</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <div class="container">

        <h1>🐍 Snake Game</h1>
        <p class="subtitle">Eat • Grow • Survive</p>

        <div class="score-board">
            <div>
                <h3>Score</h3>
                <span id="score">0</span>
            </div>

            <div>
                <h3>High Score</h3>
                <span id="highScore">0</span>
            </div>

            <div>
                <h3>Level</h3>
                <span id="level">1</span>
            </div>
        </div>

        <div class="settings">
            <label for="difficulty">Difficulty:</label>
            <select id="difficulty">
                <option value="180">Easy</option>
                <option value="120" selected>Medium</option>
                <option value="70">Hard</option>
            </select>
        </div>

        <div class="game-area">
            <canvas id="gameCanvas"
                    width="400"
                    height="400">
            </canvas>

            <div id="message">
                <h2>Ready to Play?</h2>
                <p>Press Start to begin!</p>
            </div>
        </div>

        <div class="buttons">
            <button onclick="startGame()">Start</button>
            <button onclick="pauseGame()">Pause</button>
            <button onclick="restartGame()">Restart</button>
        </div>

        <p class="instructions">
            Use Arrow Keys or W, A, S, D to move
        </p>

    </div>

    <script src="script.js"></script>

</body>
</html>

body {
    margin: 0;
    padding: 20px;
    background: #101820;
    color: white;
    font-family: Arial, sans-serif;
    text-align: center;
}

.container {
    max-width: 500px;
    margin: auto;
    background: #1c2b36;
    padding: 20px;
    border-radius: 15px;
}

h1 {
    color: #00ff88;
}

.subtitle {
    color: #bbbbbb;
}

.score-board {
    display: flex;
    justify-content: space-around;
    background: #263b48;
    border-radius: 10px;
    margin: 20px 0;
}

.score-board h3 {
    color: #00ff88;
}

.score-board span {
    font-size: 22px;
    font-weight: bold;
}

.settings {
    margin: 15px;
}

select {
    padding: 8px;
    border-radius: 5px;
}

.game-area {
    position: relative;
    width: 400px;
    max-width: 100%;
    margin: auto;
}

canvas {
    display: block;
    width: 100%;
    height: auto;
    background: #07130d;
    border: 3px solid #00ff88;
    border-radius: 8px;
}

#message {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    background: rgba(0, 0, 0, 0.75);
}

#message h2 {
    color: #00ff88;
}

#message p {
    color: white;
}

.buttons {
    margin: 20px 0;
}

button {
    padding: 12px 18px;
    margin: 5px;
    background: #00cc66;
    color: black;
    font-weight: bold;
    border: none;
    border-radius: 7px;
    cursor: pointer;
}

button:hover {
    background: #00ff88;
}

.instructions {
    color: #bbbbbb;
    font-size: 14px;
}

@media (max-width: 450px) {
    .container {
        padding: 10px;
    }

    button {
        padding: 10px;
    }
}
